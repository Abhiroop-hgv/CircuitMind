# Copy to .env and fill in. .env is gitignored and must stay that way.

# The application's own connection: reads and writes.
DATABASE_URL=postgresql://scip@127.0.0.1:5433/scip

# The restricted role the assistant connects as. Created by
# scripts/create_readonly_role.py, which writes this line for you.
DATABASE_URL_RO=postgresql://scip_readonly:<password>@127.0.0.1:5433/scip

# Groq, for reading articles and answering questions.
GROQ_API_KEY=gsk_your_key_here
